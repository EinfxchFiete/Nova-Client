{
  "name": "nova-launcher",
  "productName": "Nova Launcher",
  "version": "1.5.8",
  "description": "Launcher für Nova Client (Minecraft 26.3, Fabric)",
  "main": "src/main.js",
  "author": "Nova",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test:launch": "node test/launch-test.js",
    "dist:win": "electron-packager . \"Nova Launcher\" --platform=win32 --arch=x64 --out=dist --overwrite --asar --ignore=^/test --ignore=^/dist",
    "dist:linux": "electron-packager . \"Nova Launcher\" --platform=linux --arch=x64 --out=dist --overwrite --asar --ignore=^/test --ignore=^/dist"
  },
  "dependencies": {
    "skinview3d": "3.4.1"
  },
  "devDependencies": {
    "@electron/packager": "18.3.6",
    "electron": "38.4.0",
    "resedit": "^2.0.3"
  }
}
